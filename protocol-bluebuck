    def set_status(self, text, color="#58a6ff"):
        self.status_var.set(text)
        self.status_bar.configure(fg=color)

    def get_wifi_interface(self):
        res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], capture_output=True, text=True)
        for line in res.stdout.strip().split("\n"):
            if ":wifi" in line:
                return line.split(":")[0]
        return None

    def get_bt_interface(self):
        res = subprocess.run(["hciconfig"], capture_output=True, text=True)
        match = re.search(r"^(hci\d+):", res.stdout, re.MULTILINE)
        return match.group(1) if match else None

    def refresh_interfaces(self):
        self.wifi_iface = self.get_wifi_interface()
        self.bt_iface = self.get_bt_interface()
        self.iface_lbl.configure(text=f"Wi-Fi: {self.wifi_iface or 'None'} | BT: {self.bt_iface or 'None'}")

    # ---------------- WI-FI LOGIC ---------------- #
    def start_wifi_scan(self):
        self.refresh_interfaces()
        if not self.wifi_iface:
            messagebox.showerror("Wi-Fi Error", "No wireless interface detected!")
            return

        self.wifi_scan_btn.configure(state=tk.DISABLED, text="Scanning...")
        self.set_status(f"[*] Scanning Wi-Fi channels on {self.wifi_iface}...", "#d29922")
        threading.Thread(target=self.wifi_scan_worker, daemon=True).start()

    def wifi_scan_worker(self):
        subprocess.run(["nmcli", "device", "wifi", "rescan", "ifname", self.wifi_iface], stderr=subprocess.DEVNULL)
        cmd = ["nmcli", "-t", "-f", "IN-USE,SSID,BSSID,CHAN,SIGNAL,SECURITY", "device", "wifi", "list", "ifname", self.wifi_iface]
        res = subprocess.run(cmd, capture_output=True, text=True)

        parsed = []
        for line in res.stdout.strip().split("\n"):
            if not line:
                continue
            parts = line.replace("\\:", "_COLON_").split(":")
            if len(parts) >= 6:
                parsed.append({
                    "in_use": parts[0].strip() == "*",
                    "ssid": parts[1] if parts[1] else "<Hidden SSID>",
                    "bssid": parts[2].replace("_COLON_", ":"),
                    "channel": parts[3],
                    "signal": int(parts[4]) if parts[4].isdigit() else 0,
                    "security": parts[5] if parts[5] else "OPEN"
                })

        self.wifi_networks = sorted(parsed, key=lambda x: x["signal"], reverse=True)
        self.root.after(0, self.update_wifi_table)

    def update_wifi_table(self):
        for row in self.wifi_tree.get_children():
            self.wifi_tree.delete(row)

        for idx, net in enumerate(self.wifi_networks):
            state_str = "CONNECTED" if net["in_use"] else "READY"
            self.wifi_tree.insert(
                "",
                tk.END,
                iid=str(idx),
                values=(state_str, net["ssid"], net["bssid"], net["channel"], f"{net['signal']}%", net["security"])
            )

        self.wifi_scan_btn.configure(state=tk.NORMAL, text="↻ Scan Wi-Fi")
        self.set_status(f"[+] Wi-Fi scan complete. Found {len(self.wifi_networks)} networks.", "#3fb950")

    def prompt_wifi_connect(self):
        selected = self.wifi_tree.selection()
        if not selected:
            messagebox.showwarning("Select Wi-Fi", "Click on a Wi-Fi network from the table first.")
            return

        target = self.wifi_networks[int(selected[0])]
        password = None
        if target["security"] != "OPEN" and "--" not in target["security"]:
            password = simpledialog.askstring(
                "THE PROTOCOL WIFITE — Authenticate",
                f"Enter Wi-Fi password for:\n{target['ssid']} ({target['bssid']})",
                show="*",
                parent=self.root
            )
            if password is None:
                return

        self.wifi_pair_btn.configure(state=tk.DISABLED, text="Pairing...")
        self.set_status(f"[*] Authenticating with {target['ssid']} ({target['bssid']})...", "#d29922")
        threading.Thread(target=self.wifi_connect_worker, args=(target, password), daemon=True).start()

    def wifi_connect_worker(self, target, password):
        cmd = ["nmcli", "device", "wifi", "connect", target["bssid"], "ifname", self.wifi_iface]
        if password:
            cmd.extend(["password", password])
        res = subprocess.run(cmd, capture_output=True, text=True)
        self.root.after(0, lambda: self.finish_wifi_connect(target, res))

    def finish_wifi_connect(self, target, res):
        self.wifi_pair_btn.configure(state=tk.NORMAL, text="🔗 Pair Selected Wi-Fi")
        if res.returncode == 0:
            self.set_status(f"[+] Connected to {target['ssid']}!", "#3fb950")
            messagebox.showinfo("Connected", f"Successfully paired with {target['ssid']}!")
            self.start_wifi_scan()
        else:
            err = res.stderr.strip() or res.stdout.strip()
            self.set_status(f"[-] Wi-Fi connection failed: {err}", "#ff5555")
            messagebox.showerror("Pairing Failed", f"Could not connect to {target['ssid']}:\n\n{err}")

    # ---------------- BLUETOOTH (PROTOCOL-TOOTH) LOGIC ---------------- #
    def start_bt_scan(self):
        self.refresh_interfaces()
        self.bt_scan_btn.configure(state=tk.DISABLED, text="Scanning (8s)...")
        self.set_status("[*] Starting Bluetooth service & scanning nearby devices for 8 seconds...", "#d29922")
        threading.Thread(target=self.bt_scan_worker, daemon=True).start()

    def bt_scan_worker(self):
        subprocess.run(["systemctl", "start", "bluetooth"], stderr=subprocess.DEVNULL)
        subprocess.run(["rfkill", "unblock", "bluetooth"], stderr=subprocess.DEVNULL)
        subprocess.run(["bluetoothctl", "power", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Actively scan for 8 seconds to populate bluetoothctl cache
        subprocess.run(["bluetoothctl", "--timeout", "8", "scan", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True)
        devices = []
        for line in res.stdout.strip().split("\n"):
            match = re.match(r"^Device\s+([0-9A-Fa-f:]{17})\s+(.*)$", line.strip())
            if match:
                mac = match.group(1)
                name = match.group(2).strip() or "<Unknown Device>"

                info_res = subprocess.run(["bluetoothctl", "info", mac], capture_output=True, text=True).stdout
                paired = "yes" in re.findall(r"Paired:\s+(\w+)", info_res)
                trusted = "yes" in re.findall(r"Trusted:\s+(\w+)", info_res)
                connected = "yes" in re.findall(r"Connected:\s+(\w+)", info_res)

                devices.append({
                    "mac": mac,
                    "name": name,
                    "paired": paired,
                    "trusted": trusted,
                    "connected": connected
                })

        self.bt_devices = sorted(devices, key=lambda d: (d["connected"], d["paired"]), reverse=True)
        self.root.after(0, self.update_bt_table)

    def update_bt_table(self):
        for row in self.bt_tree.get_children():
            self.bt_tree.delete(row)

        for idx, dev in enumerate(self.bt_devices):
            state = "CONNECTED" if dev["connected"] else "AVAILABLE"
            self.bt_tree.insert(
                "",
                tk.END,
                iid=str(idx),
                values=(
                    state,
                    dev["name"],
                    dev["mac"],
                    "YES" if dev["paired"] else "NO",
                    "YES" if dev["trusted"] else "NO"
                )
            )

        self.bt_scan_btn.configure(state=tk.NORMAL, text="↻ Scan Bluetooth (8s)")
        self.set_status(f"[+] Bluetooth scan complete. Found {len(self.bt_devices)} devices.", "#3fb950")

    def prompt_bt_connect(self):
        selected = self.bt_tree.selection()
        if not selected:
            messagebox.showwarning("Select Bluetooth Device", "Click on a Bluetooth device from the table first.")
            return

        target = self.bt_devices[int(selected[0])]
        self.bt_pair_btn.configure(state=tk.DISABLED, text="Pairing...")
        self.set_status(f"[*] Pairing and connecting to {target['name']} ({target['mac']})...", "#d29922")
        threading.Thread(target=self.bt_connect_worker, args=(target,), daemon=True).start()

    def bt_connect_worker(self, target):
        mac = target["mac"]
        subprocess.run(["bluetoothctl", "trust", mac], capture_output=True, text=True)
        subprocess.run(["bluetoothctl", "pair", mac], capture_output=True, text=True)
        res = subprocess.run(["bluetoothctl", "connect", mac], capture_output=True, text=True)
        self.root.after(0, lambda: self.finish_bt_connect(target, res))

    def finish_bt_connect(self, target, res):
        self.bt_pair_btn.configure(state=tk.NORMAL, text="🦷 Pair & Connect Selected")
        output = (res.stdout + "\n" + res.stderr).strip()
        if "Connection successful" in output or res.returncode == 0:
            self.set_status(f"[+] Connected to Bluetooth device {target['name']} ({target['mac']})!", "#3fb950")
            messagebox.showinfo("Bluetooth Connected", f"Successfully paired & connected to:\n{target['name']} ({target['mac']})")
            self.start_bt_scan()
        else:
            self.set_status(f"[-] Bluetooth connection failed for {target['mac']}", "#ff5555")
            messagebox.showerror("Bluetooth Failed", f"Could not connect to {target['name']}:\n\n{output}")

    def disconnect_bt(self):
        selected = self.bt_tree.selection()
        if not selected:
            messagebox.showwarning("Select Device", "Select a Bluetooth device to disconnect.")
            return
        target = self.bt_devices[int(selected[0])]
        subprocess.run(["bluetoothctl", "disconnect", target["mac"]], capture_output=True)
        self.set_status(f"[*] Disconnected {target['name']} ({target['mac']})", "#58a6ff")
        self.start_bt_scan()

    # ---------------- EXPORT REPORT ---------------- #
    def save_report(self):
        try:
            report_data = {
                "tool": "THE PROTOCOL WIFITE & TOOTH",
                "author": "Laltesh Chaudhary",
                "wifi_networks": self.wifi_networks,
                "bluetooth_devices": self.bt_devices
            }
            with open(REPORT_PATH, "w") as f:
                json.dump(report_data, f, indent=4)
            self.set_status(f"[+] Unified Wi-Fi & Bluetooth report saved to {REPORT_PATH}", "#3fb950")
        except Exception as e:
            self.set_status(f"[-] Failed to save report: {e}", "#ff5555")

def main():
    if os.geteuid() != 0:
        print("[!] Please run with sudo: sudo -E protocol-bluebuck")
        sys.exit(1)

    root = tk.Tk()
    app = ProtocolWifiteGUI(root)
    root.mainloop()

if __name__ == "__main__":
    main()
